# Use a long random value in production. Never reuse the development fallback.
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGIN=http://localhost:5173
PORT=3000
# Optional absolute path for the platform SQLite file.
# DB_PATH=C:/path/to/platform.sqlite
# For npm run seed, set these in the shell environment (do not commit secrets).
# SEED_ADMIN_EMAIL=admin@rentalku.com
# SEED_ADMIN_PASSWORD=replace-with-at-least-12-characters
